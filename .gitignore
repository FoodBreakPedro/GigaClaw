# Build outputs
bin/
obj/
publish/
publish-*/
TestResults/
/artifacts/eval/

# User-specific files
*.user
*.suo
.vs/

# Rider
.idea/

# Logs
*.log

# NuGet
*.nupkg
*.snupkg
packages/

# dotnet watch
.dotnet-watch

# ASP.NET
appsettings.Development.json

# Database files
*.db
*.db-shm
*.db-wal
GigaClaw.Web/data/

# OS
.DS_Store
Thumbs.db
.claude
.vscode

# Agent skills, automations config and runtime state — local to each workspace.
.agents
.dashboard
# …but the project template's dashboard tiles ARE source (embedded into GigaClaw.Core.dll).
!ProjectTemplate/.dashboard/
!ProjectTemplate/.dashboard/**
/doc/.obsidian

# Python bytecode from running the agent contract validators locally. These would
# otherwise be embedded into GigaClaw.Core and copied into every workspace.
__pycache__/
*.pyc


# Transient lock from the graphify hook (the graph output itself is tracked).
graphify-out/.rebuild.lock

# Graphify machine-local artifacts. Only the outputs agents consume stay tracked
# (graph.json, GRAPH_REPORT.md, GRAPH_TREE.html, manifest.json and the top-level
# dotfiles); the AST cache, dated snapshot dirs and the interactive graph page
# are rebuild products that grow by tens of MB per active day.
graphify-out/cache/
graphify-out/20*/
graphify-out/graph.html

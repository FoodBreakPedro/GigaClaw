<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GigaClaw.Core\GigaClaw.Core.csproj" />
    <ProjectReference Include="..\GigaClaw.QaRunner\GigaClaw.QaRunner.csproj" />
    <ProjectReference Include="..\GigaClaw.Web\GigaClaw.Web.csproj" />
    <ProjectReference Include="..\GigaClaw.Catalog\GigaClaw.Catalog.csproj" />
    <ProjectReference Include="..\GigaClaw.ClaudeMock\GigaClaw.ClaudeMock.csproj" />
    <ProjectReference Include="..\GigaClaw.CodexMock\GigaClaw.CodexMock.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Collections run in parallel. Fixtures that mutate process-wide env vars are serialized
         through shared collections instead: "MockClaude" (GIGACLAW_CLAUDE_BIN), "MockCodex"
         (GIGACLAW_CODEX_BIN), and "ApiHost"
         (GIGACLAW_DATA_DIR). -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="GigaClaw.Core.Automation" />
    <Using Include="GigaClaw.Core.Automation.Triggers" />
    <Using Include="GigaClaw.Core.Models" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Markdig" Version="1.1.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GigaClaw.Core\GigaClaw.Core.csproj" />
    <ProjectReference Include="..\GigaClaw.QaRunner\GigaClaw.QaRunner.csproj" />
    <ProjectReference Include="..\GigaClaw.Web\GigaClaw.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Several fixtures mutate process-wide env vars (GIGACLAW_DATA_DIR, GIGACLAW_CLAUDE_BIN);
         parallel collections race on them and can deadlock the whole run. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="GigaClaw.Core.Automation" />
    <Using Include="GigaClaw.Core.Automation.Triggers" />
    <Using Include="GigaClaw.Core.Models" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json">
      <LogicalName>GigaClaw.Core.Localization.%(Filename)%(Extension)</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Template files for new project initialization. Source of truth lives under
         ProjectTemplate/Agents/ at the repo root (Agents/ without the dot to avoid the
         workspace .gitignore that hides any `.agents/` runtime data). LogicalName prefixes
         are kept stable so AgentsTemplateService doesn't need to know about the on-disk
         layout — it discovers resources by prefix, not by source path. The destination at
         Initialize time is still `<workspace>/.agents/`. -->
    <EmbeddedResource Include="..\ProjectTemplate\Agents\memory-consolidation.md">
      <LogicalName>GigaClaw.Core.AgentsTemplate/memory-consolidation.md</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="..\ProjectTemplate\Agents\preamble.md">
      <LogicalName>GigaClaw.Core.AgentsTemplate/preamble.md</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="..\ProjectTemplate\Agents\automations.json">
      <LogicalName>GigaClaw.Core.AgentsTemplate/automations.json</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="..\ProjectTemplate\Agents\contracts.json">
      <LogicalName>GigaClaw.Core.AgentsTemplate/contracts.json</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <!-- The declared shape of a deliverable's journey. Shipped as a *declaration*: it is what the
         board reads to name a deliverable's stages and place a ticket among them. Nothing executes
         it — the content pipeline is driven by the handoff automations in automations.json, and no
         `startWorkflow` action fires it. Validated at every AutomationStore.LoadAsync, so a broken
         graph here fails the whole automation reload; see doc/workflow-graph.md. -->
    <EmbeddedResource Include="..\ProjectTemplate\Agents\workflow.json">
      <LogicalName>GigaClaw.Core.AgentsTemplate/workflow.json</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <!-- AD-9 model seeding: agent-slug -> default Claude model id, read by
         AgentsTemplateService.DefaultModels() at member-creation time. -->
    <EmbeddedResource Include="..\ProjectTemplate\Agents\models.json">
      <LogicalName>GigaClaw.Core.AgentsTemplate/models.json</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <!-- Team roster. The nine built-in teams are data, not C# constants: AgentTeamService reads
         this file, Initialize writes it to <workspace>/.agents/teams.json, and anything that
         composes into that file (a pack, or the owner) adds a team or a membership without
         recompiling GigaClaw.Core. See doc/executable-teams.md. -->
    <EmbeddedResource Include="..\ProjectTemplate\Agents\teams.json">
      <LogicalName>GigaClaw.Core.AgentsTemplate/teams.json</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="..\ProjectTemplate\Agents\BRAND.md">
      <LogicalName>GigaClaw.Core.AgentsTemplate/BRAND.md</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="..\ProjectTemplate\Agents\VOICE.md">
      <LogicalName>GigaClaw.Core.AgentsTemplate/VOICE.md</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <!-- The Exclude is load-bearing, not tidiness: MSBuild globs the working directory, not git,
         so running the contract validators locally leaves __pycache__ bytecode that would otherwise
         be embedded here and written into every initialized workspace. -->
    <EmbeddedResource Include="..\ProjectTemplate\Agents\scripts\**\*.*"
                      Exclude="..\ProjectTemplate\Agents\scripts\**\__pycache__\**;..\ProjectTemplate\Agents\scripts\**\*.pyc">
      <LogicalName>GigaClaw.Core.AgentsTemplate/scripts/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="..\ProjectTemplate\Agents\**\SKILL.md">
      <LogicalName>GigaClaw.Core.AgentsTemplate/%(RecursiveDir)SKILL.md</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <!-- Progressive disclosure (G4): SKILL.md is the always-loaded index and the detail lives in
         references/. Those files are read on demand, so a SKILL that links to one and does not ship
         it leaves the agent pointing at a file that does not exist in its workspace. They were
         committed without being embedded, which is why this glob exists. -->
    <EmbeddedResource Include="..\ProjectTemplate\Agents\**\references\*.md">
      <LogicalName>GigaClaw.Core.AgentsTemplate/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <!-- The shared handoff reference (G3). Sits at Agents/ root like preamble.md, so neither the
         per-agent globs above nor the workspace-root glob below picks it up. -->
    <EmbeddedResource Include="..\ProjectTemplate\Agents\handoff.md">
      <LogicalName>GigaClaw.Core.AgentsTemplate/handoff.md</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <!-- New per-topic memory layout: each agent ships a memory/MEMORY.md index skeleton. Topic
         files are created at runtime by the consolidation pass, so only the index is embedded. -->
    <EmbeddedResource Include="..\ProjectTemplate\Agents\**\memory\*.md">
      <LogicalName>GigaClaw.Core.AgentsTemplate/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <!-- Files copied to the workspace root on Initialize (e.g. CLAUDE.md). The glob excludes
         the Agents/ subtree since those go through the AgentsTemplate prefix above, and pack.json
         because that is core's *manifest*, not workspace content: it is embedded under the Packs
         prefix below and must never be written into a workspace root. -->
    <!-- The .DS_Store/Thumbs.db exclusions are the same class of hazard as the __pycache__ one
         above, and for the same reason: MSBuild globs the working directory, not git. Finder
         writes .DS_Store into ProjectTemplate/ the first time anyone opens it; it is gitignored
         but still on disk, so without this it is embedded, written into every initialized
         workspace, and then rejected by core's own pack composition as an undeclared root file. -->
    <EmbeddedResource Include="..\ProjectTemplate\**\*.*"
                      Exclude="..\ProjectTemplate\Agents\**\*.*;..\ProjectTemplate\pack.json;..\ProjectTemplate\**\.DS_Store;..\ProjectTemplate\**\Thumbs.db;..\ProjectTemplate\**\desktop.ini">
      <LogicalName>GigaClaw.Core.AgentsTemplateRoot/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <!-- Pack manifests (doc/pack-infrastructure.md §2), prefix GigaClaw.Core.Packs/<pack-id>/…
         `core` is the one pack whose content is *not* also under this prefix: ProjectTemplate/
         stays in place (§2 D1), so its Agents/ and root files keep the two AgentsTemplate prefixes
         above and CorePackSource maps all three onto one IPackSource. That asymmetry is what lets
         CatalogGenerator, StaticEvalRunner, evalconfig.json and the template contract tests keep
         pointing at the literal path `ProjectTemplate/Agents`. -->
    <EmbeddedResource Include="..\ProjectTemplate\pack.json">
      <LogicalName>GigaClaw.Core.Packs/core/pack.json</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <!-- Every *other* pack, embedded as a verbatim image of its directory: pack.json, Agents/**
         and the pack's workspace-root files all keep their pack-relative path under
         GigaClaw.Core.Packs/<pack-id>/. Q1 makes packs repo-only, which means the shipped
         GigaClaw.Core.dll is the only place a production install can read a pack from — without
         this the Security pack is installable from a working tree and from nowhere else.
         eval/** is excluded because §2 makes it build-time only: fixtures ship with the pack in
         the repository and must never reach a workspace. The noise exclusions are the same
         working-directory-not-git hazard as the two globs above (§6). -->
    <EmbeddedResource Include="..\Packs\**\*.*"
                      Exclude="..\Packs\*\eval\**\*.*;..\Packs\**\*.pyc;..\Packs\**\.DS_Store;..\Packs\**\Thumbs.db;..\Packs\**\desktop.ini">
      <LogicalName>GigaClaw.Core.Packs/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>GigaClaw.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!-- Pins the transitive SQLitePCLRaw bundle above 2.1.11 (CVE-2025-6965 / GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <!-- IHttpClientFactory for the httpRequest automation action. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="NCrontab" Version="3.4.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>

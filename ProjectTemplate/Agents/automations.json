    {
      "id": "auto-review-on-all-subs-done",
      "name": "Parent to Review when all sub-tickets are Done",
      "enabled": true,
      "trigger": {
        "type": "subTicketStatus",
        "pollSeconds": 30,
        "parentColumn": "InProgress"
      },
      "conditions": [
        {
          "type": "allSubTicketsInStatus",
          "statuses": [
            "Done"
          ],
          "negate": false
        }
      ],
      "actions": [
        {
          "type": "moveTicketStatus",
          "to": "Review"
        },
        {
          "type": "addComment",
          "content": "All sub-tickets are Done. Parent moved to Review automatically.",
          "author": "system"
        }
      ]
    },
    {

      "actions": [
        {
          "type": "runAgent",
          "agent": "producer",
          "maxTurns": 50,
          "concurrencyGroup": "producer",
          "mutuallyExclusiveWith": [],
          "env": {},
          "model": "claude-sonnet-4-6",
          "restoreStatusOnFail": true
        },
        {
          "type": "consolidateAgentMemory",
          "agent": "producer"
        },
        {
          "type": "commitAgentMemory",
          "agent": "producer"
        }
      ]
    },
    {
      "id": "evaluator-on-done",

    {
      "id": "weekly-ticket-example",
      "name": "Example: create a weekly review ticket every Monday",
      "enabled": false,
      "trigger": {
        "type": "interval",
        "cron": "0 9 * * MON"
      },
      "conditions": [],
      "actions": [
        {
          "type": "createTicket",
          "title": "Weekly review {monday}",
          "description": "Automated weekly review ticket for the week starting {monday}.",
          "status": "Todo",
          "priority": "NiceToHave",
          "createdBy": "automation",
          "skipIfExists": true
        }
      ]
    },
    {
      "id": "documentalist-on-commit",
      "name": "Documentalist: keep docs in sync after each non-AI commit",
      "enabled": true,
      "trigger": {
        "type": "gitCommit",
        "pollSeconds": 60,
        "ignoreAuthors": [
          "documentalist@gigaclaw.local",
          "code-janitor@gigaclaw.local",
          "memory@gigaclaw.local",
          "noreply@anthropic.com"
        ]
      },
      "conditions": [],
      "actions": [
        {
          "type": "runAgent",
          "agent": "documentalist",
          "maxTurns": 100,
          "concurrencyGroup": "git",
          "mutuallyExclusiveWith": [],
          "env": {},
          "model": "claude-sonnet-4-6",
          "restoreStatusOnFail": false,
          "context": "No commit range is provided in this prompt. Derive it yourself: run `git log --format='%H %ae %s' -n 20` and process the commits since your last own commit (author documentalist@gigaclaw.local). If you cannot find one, process only HEAD."
        },
        {
          "type": "consolidateAgentMemory",
          "agent": "documentalist"
        },
        {
          "type": "commitAgentMemory",
          "agent": "documentalist"
        }
      ]
    },
    {

    {
      "id": "decision-receipt-on-done",
      "name": "Decision Engine: ADR receipt when a decision-labeled ticket closes",
      "enabled": true,
      "trigger": {
        "type": "statusChange",
        "pollSeconds": 30,
        "to": "Done"
      },
      "conditions": [
        {
          "type": "labels",
          "labels": [
            "decision",
            "adr"
          ]
        }
      ],
      "actions": [
        {
          "type": "runAgent",
          "agent": "decision-engine",
          "maxTurns": 40,
          "concurrencyGroup": "decision-engine",
          "mutuallyExclusiveWith": [],
          "env": {},
          "model": "claude-sonnet-4-6",
          "restoreStatusOnFail": false
        },
        {
          "type": "consolidateAgentMemory",
          "agent": "decision-engine"
        },
        {
          "type": "commitAgentMemory",
          "agent": "decision-engine"
        }
      ]
    },
    {
      "id": "stale-blocked-nudge",
      "name": "Nudge: ping the owner about tickets stuck in Blocked",
      "enabled": true,
      "trigger": {
        "type": "ticketInColumn",
        "seconds": 3600,
        "columns": [
          "Blocked"
        ],
        "debounceSeconds": 86400
      },
      "conditions": [
        {
          "type": "ticketAge",
          "field": "updatedAt",
          "mode": "olderThan",
          "hours": 72
        }
      ],
      "actions": [
        {
          "type": "addComment",
          "author": "system",
          "content": "This ticket has been Blocked for 3+ days. @owner - unblock, re-scope, or close?"
        }
      ]
    }
  ]
}

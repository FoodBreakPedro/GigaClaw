    {
      "id": "documentalist-on-commit",
      "name": "Documentalist: keep docs in sync after each non-AI commit",
      "enabled": true,
      "trigger": {
        "type": "gitCommit",
        "pollSeconds": 60,
        "ignoreAuthors": [
          "documentalist@gigaclaw.local",
          "code-janitor@gigaclaw.local",
          "decision-engine@gigaclaw.local",
          "memory@gigaclaw.local",
          "noreply@anthropic.com"
        ]
      },
      "conditions": [],
      "actions": [
        {
          "type": "runAgent",
          "agent": "documentalist",
          "maxTurns": 100,
          "concurrencyGroup": "git",
          "mutuallyExclusiveWith": [],
          "env": {},
          "model": "claude-sonnet-4-6",
          "restoreStatusOnFail": false,
          "context": "No commit range is provided in this prompt. Follow the documentalist durable-cursor protocol: read `.agents/documentalist/memory/state.json`, validate the recorded commit is an ancestor of HEAD, process the complete cursor..HEAD range, and advance the cursor only after documentation validation and commit succeed. Do not substitute a fixed git-log window or HEAD-only fallback."
        },
        {
          "type": "consolidateAgentMemory",
          "agent": "documentalist"
        },
        {
          "type": "commitAgentMemory",
          "agent": "documentalist"
        }
      ]
    },

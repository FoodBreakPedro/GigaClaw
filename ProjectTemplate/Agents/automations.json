    {
      "id": "code-janitor-nightly",
      "name": "Code Janitor: periodic codebase hygiene",
      "enabled": true,
      "trigger": {
        "type": "interval",
        "cron": "0 3 * * *"
      },
      "conditions": [],
      "actions": [
        {
          "type": "runAgent",
          "agent": "code-janitor",
          "maxTurns": 80,
          "concurrencyGroup": "git",
          "mutuallyExclusiveWith": [],
          "env": {},
          "model": "claude-sonnet-4-6",
          "restoreStatusOnFail": false
        },
        {
          "type": "consolidateAgentMemory",
          "agent": "code-janitor"
        },
        {
          "type": "commitAgentMemory",
          "agent": "code-janitor"
        }
      ]

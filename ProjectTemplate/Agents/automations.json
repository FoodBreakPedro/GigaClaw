      "enabled": true,
      "trigger": {
        "type": "statusChange",
        "pollSeconds": 30,
        "to": "Done"
      },
      "conditions": [],
      "actions": [
        {
          "type": "runAgent",
          "agent": "committer",
          "maxTurns": 50,
          "concurrencyGroup": "git",
          "mutuallyExclusiveWith": [],
          "env": {},
          "model": "claude-sonnet-4-6",
          "restoreStatusOnFail": false
        },
        {
          "type": "consolidateAgentMemory",
          "agent": "committer"
        },
        {
          "type": "commitAgentMemory",
          "agent": "committer"
        }
      ]
    },
    {
      "id": "producer-on-subtick",

{
  "automations": [
    {
      "id": "assignee-dispatch",
      "name": "Dispatch: Todo ticket -> InProgress + run assigned agent",
      "enabled": true,
      "trigger": {
        "type": "ticketInColumn",
        "seconds": 30,
        "columns": [
          "Todo"
        ],
        "debounceSeconds": 0,
        "maxConsecutiveFirings": 3,
        "retryBackoffSeconds": 300,
        "exhaustedStatus": "Blocked",
        "exhaustedComment": "Automation stopped after 3 unchanged dispatch attempts. Add owner feedback or revise the ticket before retrying."
      },
      "conditions": [
        {
          "type": "assignedTo",
          "slugs": [
            "programmer",
            "producer",
            "qa-tester",
            "groomer",
            "blog-writer",
            "blog-reviewer",
            "blog-researcher",
            "blog-seo",
            "blog-translator",
            "growth-writer",
            "lead-magnet-creator",
            "trend-researcher",
            "email-copywriter",
            "ui-designer",
            "ui-auditor",
            "design-researcher",
            "data-analyst",
            "competitive-analyst",
            "local-media-director",
            "local-image-artist",
            "local-motion-artist",
            "local-media-compositor",
            "local-media-reviewer",
            "approval-gatekeeper",
            "system-watchdog",
            "decision-engine",
            "wellness-coach",
            "content-series-planner"
          ]
        },
        {
          "type": "ticketCountInColumn",
          "columns": [
            "InProgress"
          ],
          "sameAssignee": true,
          "operator": "==",
          "value": 0
        }
      ],
      "actions": [
        {
          "type": "moveTicketStatus",
          "to": "InProgress"
        },
        {
          "type": "runAgent",
          "agent": "{assignee}",
          "concurrencyGroup": "{assignee}",
          "maxTurns": 100,
          "mutuallyExclusiveWith": [],
          "env": {},
          "model": "claude-sonnet-4-6",
          "restoreStatusOnFail": true
        },
        {
          "type": "consolidateAgentMemory",
          "agent": "{assignee}"
        },
        {
          "type": "commitAgentMemory",
          "agent": "{assignee}"
        }
      ]
    },
    {
      "id": "groomer",
      "name": "Groomer: enrich Backlog tickets assigned to groomer",
      "enabled": true,
      "trigger": {
        "type": "ticketInColumn",
        "seconds": 30,
        "columns": [
          "Backlog"
        ],
        "assigneeSlug": "groomer",
        "debounceSeconds": 0,
        "maxConsecutiveFirings": 3,
        "retryBackoffSeconds": 600,
        "exhaustedStatus": "Blocked",
        "exhaustedComment": "Grooming stopped after 3 unchanged attempts. Add missing context or revise the ticket before retrying."
      },
      "conditions": [],
      "actions": [
        {
          "type": "runAgent",
          "agent": "groomer",
          "maxTurns": 30,
          "concurrencyGroup": "groomer",
          "mutuallyExclusiveWith": [],
          "env": {},
          "model": "claude-haiku-4-5",
          "restoreStatusOnFail": true
        },
        {
          "type": "consolidateAgentMemory",
          "agent": "groomer"
        },
        {
          "type": "commitAgentMemory",
          "agent": "groomer"
        }
      ]
    },
    {
      "id": "committer-on-done",
      "name": "Committer: commit changes when a ticket reaches Done",
      "enabled": true,
      "trigger": {
        "type": "statusChange",
        "pollSeconds": 30,
        "to": "Done"
      },
      "conditions": [
        {
          "type": "labels",
          "labels": [
            "decision",
            "adr"

{
  "automations": [
    {
      "id": "assignee-dispatch",
      "name": "Dispatch: Todo ticket -> InProgress + run assigned agent",
      "enabled": true,
      "trigger": {
        "type": "ticketInColumn",
        "seconds": 30,
        "columns": [
          "Todo"
        ],
        "debounceSeconds": 0
      },
      "conditions": [
        {
          "type": "assignedTo",
          "slugs": [
            "programmer",
            "producer",
            "qa-tester",
            "groomer",
            "blog-writer",
            "blog-reviewer",
            "blog-researcher",
            "blog-seo",
            "blog-translator",
            "growth-writer",
            "lead-magnet-creator",
            "trend-researcher",
            "email-copywriter",
            "ui-designer",
            "ui-auditor",
            "design-researcher",
            "data-analyst",
            "competitive-analyst",
            "approval-gatekeeper",
            "system-watchdog",
            "decision-engine",
            "wellness-coach",
            "content-series-planner"
          ]
        },
        {
          "type": "ticketCountInColumn",
          "columns": [
            "InProgress"
          ],
          "sameAssignee": true,
          "operator": "==",
          "value": 0
        }
      ],
      "actions": [
        {
          "type": "moveTicketStatus",
          "to": "InProgress"
        },
        {
          "type": "runAgent",
          "agent": "{assignee}",
          "concurrencyGroup": "{assignee}",
          "maxTurns": 100,
          "mutuallyExclusiveWith": [],
          "env": {},
          "model": "claude-sonnet-4-6",
          "restoreStatusOnFail": true
        },
        {
          "type": "consolidateAgentMemory",
          "agent": "{assignee}"
        },
        {
          "type": "commitAgentMemory",
          "agent": "{assignee}"
        }
      ]
    },
    {
      "id": "groomer",
      "name": "Groomer: enrich Backlog tickets assigned to groomer",
      "enabled": true,
      "trigger": {
        "type": "ticketInColumn",
        "seconds": 30,
        "columns": [
          "Backlog"
        ],
        "assigneeSlug": "groomer",
        "debounceSeconds": 0
      },
      "conditions": [],
      "actions": [
        {
          "type": "runAgent",
          "agent": "groomer",
          "maxTurns": 30,
          "concurrencyGroup": "groomer",
          "mutuallyExclusiveWith": [],
          "env": {},
          "model": "claude-haiku-4-5",
          "restoreStatusOnFail": true
        },
        {
          "type": "consolidateAgentMemory",
          "agent": "groomer"
        },
        {
          "type": "commitAgentMemory",
          "agent": "groomer"
        }
      ]
    },
    {
      "id": "committer-on-done",

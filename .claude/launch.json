{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gigaclaw-web",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["watch", "--project", "GigaClaw.Web", "--non-interactive"],
      "port": 5230
    },
    {
      "name": "gigaclaw-web-devcheck",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["watch", "--project", "GigaClaw.Web", "--non-interactive", "--", "--urls", "http://localhost:5231"],
      "port": 5231
    },
    {
      "name": "gigaclaw-web-debug",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "tools/run-debug-instance.cs"],
      "port": 5232
    }
  ]
}

@using GigaClaw.Core.Automation
@using GigaClaw.Core.Models
@inject LocalizationService L

<div class="node-editor">
    <label>@L["Type"]
        <select value="@CurrentType" @onchange="OnTypeChanged">
            <option value="ticketInColumn">@L["CondTypeTicketInColumn"]</option>
            <option value="fieldLength">@L["CondTypeFieldLength"]</option>
            <option value="priority">@L["CondTypePriority"]</option>
            <option value="labels">@L["CondTypeLabels"]</option>
            <option value="assignedTo">@L["CondTypeAssignedTo"]</option>
            <option value="ticketAge">@L["CondTypeTicketAge"]</option>
            <option value="hasParent">@L["CondTypeHasParent"]</option>
            <option value="allSubTicketsInStatus">@L["CondTypeAllSubTicketsInStatus"]</option>
            <option value="ticketCountInColumn">@L["CondTypeTicketCountInColumn"]</option>
            <option value="verdictIs">@L["CondTypeVerdictIs"]</option>
            <option value="repairBudget">@L["CondTypeRepairBudget"]</option>
            <option value="reviewerRetryBudget">@L["CondTypeReviewerRetryBudget"]</option>
            <option value="dependenciesResolved">@L["CondTypeDependenciesResolved"]</option>
        </select>
    </label>

    <label class="column-check negate-toggle"><input type="checkbox" checked="@Condition.Negate"
               @onchange="e => Condition.Negate = (bool)e.Value!" /><span>@L["Negate"]</span></label>

    @switch (Condition)
    {
        case TicketInColumnConditionSpec s:
            <div class="column-picker">
                <div class="column-picker-label">@L["ColumnsOneOrMore"]</div>
                @foreach (var c in Columns)
                {
                    var col = c;
                    <label class="column-check"><input type="checkbox" checked="@s.Columns.Contains(col)"
                               @onchange="e => ToggleColumn(s.Columns, col, (bool)e.Value!)" /><span>@col</span></label>
                }
            </div>
            <label>@L["AssigneeOptional"]
                <select value="@(s.AssigneeSlug ?? "")" @onchange="e => s.AssigneeSlug = string.IsNullOrEmpty((string?)e.Value) ? null : (string)e.Value!">
                    <option value="">@L["AnyMember"]</option>
                    @foreach (var sk in Skills) { <option value="@sk">@sk</option> }
                </select>
            </label>
            break;
        case MinDescriptionLengthConditionSpec s:
            <label>@L["MinLength"]
                <input type="number" @bind="s.Length" />
            </label>
            break;
        case FieldLengthConditionSpec s:
            <label>@L["Field"]
                <select value="@s.Field" @onchange="e => s.Field = (string)e.Value!">
                    <option value="description">@L["FieldDescription"]</option>
                    <option value="title">@L["FieldTitle"]</option>
                </select>
            </label>
            <label>@L["Mode"]
                <select value="@s.Mode" @onchange="e => s.Mode = (string)e.Value!">
                    <option value="min">@L["ModeMin"]</option>
                    <option value="max">@L["ModeMax"]</option>
                </select>
            </label>
            <label>@L["CharCount"]
                <input type="number" @bind="s.Length" />
            </label>
            break;
        case PriorityConditionSpec s:
            <div class="column-picker">
                <div class="column-picker-label">@L["PrioritiesOneOrMore"]</div>
                @foreach (var p in Enum.GetNames<TicketPriority>())
                {
                    var prio = p;
                    <label class="column-check"><input type="checkbox" checked="@s.Priorities.Contains(prio)"
                               @onchange="e => ToggleColumn(s.Priorities, prio, (bool)e.Value!)" /><span>@prio</span></label>
                }
            </div>
            break;
        case LabelsConditionSpec s:
            <label>@L["LabelsCsv"]
                <input type="text" value="@string.Join(", ", s.Labels)"
                       @onchange="e => s.Labels = ((string)e.Value!).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList()" />
            </label>
            break;
        case AssignedToConditionSpec s:
            <div class="column-picker">
                <div class="column-picker-label">@L["AssignedToOneOrMore"]</div>
                @foreach (var sk in Skills)
                {
                    var slug = sk;
                    <label class="column-check"><input type="checkbox" checked="@s.Slugs.Contains(slug)"
                               @onchange="e => ToggleColumn(s.Slugs, slug, (bool)e.Value!)" /><span>@slug</span></label>
                }
            </div>
            break;
        case HasParentConditionSpec s:
            <label class="column-check"><input type="checkbox" checked="@s.Value"
                       @onchange="e => s.Value = (bool)e.Value!" /><span>@L["HasParentLabel"]</span></label>
            break;
        case AllSubTicketsInStatusConditionSpec s:
            <div class="column-picker">
                <div class="column-picker-label">@L["AllSubTicketsStatusesLabel"]</div>
                @foreach (var c in Columns)
                {
                    var col = c;
                    <label class="column-check"><input type="checkbox" checked="@s.Statuses.Contains(col)"
                               @onchange="e => ToggleColumn(s.Statuses, col, (bool)e.Value!)" /><span>@col</span></label>
                }
            </div>
            break;
        case TicketCountInColumnConditionSpec s:
            <div class="column-picker">
                <div class="column-picker-label">@L["ColumnsOneOrMore"]</div>
                @foreach (var c in Columns)
                {
                    var col = c;
                    <label class="column-check"><input type="checkbox" checked="@s.Columns.Contains(col)"
                               @onchange="e => ToggleColumn(s.Columns, col, (bool)e.Value!)" /><span>@col</span></label>
                }
            </div>
            <label class="column-check"><input type="checkbox" checked="@s.SameAssignee"
                       @onchange="e => s.SameAssignee = (bool)e.Value!" /><span>@L["CondCountSameAssignee"]</span></label>
            <label>@L["AssigneeOptional"]
                <select value="@(s.AssigneeSlug ?? "")" disabled="@s.SameAssignee"
                        @onchange="e => s.AssigneeSlug = string.IsNullOrEmpty((string?)e.Value) ? null : (string)e.Value!">
                    <option value="">@L["AnyMember"]</option>
                    @foreach (var sk in Skills) { <option value="@sk">@sk</option> }
                </select>
            </label>
            <label>@L["CondCountOperator"]
                <select value="@s.Operator" @onchange="e => s.Operator = (string)e.Value!">
                    <option value="==">=</option>
                    <option value="!=">!=</option>
                    <option value="&lt;">&lt;</option>
                    <option value="&lt;=">&lt;=</option>
                    <option value="&gt;">&gt;</option>
                    <option value="&gt;=">&gt;=</option>
                </select>
            </label>
            <label>@L["CondCountValue"]
                <input type="number" @bind="s.Value" min="0" />
            </label>
            break;
        case VerdictIsConditionSpec s:
            <div class="column-picker">
                <div class="column-picker-label">@L["VerdictOutcomes"]</div>
                @foreach (var outcome in VerdictOutcomeKeys)
                {
                    var value = outcome.Key;
                    var label = outcome.Label;
                    <label class="column-check"><input type="checkbox" checked="@s.Verdicts.Contains(value)"
                               @onchange="e => ToggleColumn(s.Verdicts, value, (bool)e.Value!)" /><span>@L[label]</span></label>
                }
            </div>
            <label>@L["VerdictAgent"]
                <select value="@(s.Agent ?? "")" @onchange="e => s.Agent = string.IsNullOrEmpty((string?)e.Value) ? null : (string)e.Value!">
                    <option value="">@L["AnyMember"]</option>
                    @foreach (var sk in Skills) { <option value="@sk">@sk</option> }
                </select>
            </label>
            <label class="column-check"><input type="checkbox" checked="@s.RequireFreshArtifact"
                       @onchange="e => s.RequireFreshArtifact = (bool)e.Value!" /><span>@L["VerdictRequireFresh"]</span></label>
            break;
        case RepairBudgetConditionSpec s:
            <label>@L["RepairMode"]
                <select value="@s.Mode" @onchange="e => s.Mode = (string)e.Value!">
                    <option value="withinCap">@L["RepairModeWithinCap"]</option>
                    <option value="exhausted">@L["RepairModeExhausted"]</option>
                </select>
            </label>
            <label>@L["RepairReviewer"]
                <select value="@(s.Agent ?? "")" @onchange="e => s.Agent = string.IsNullOrEmpty((string?)e.Value) ? null : (string)e.Value!">
                    <option value="">@L["AnyMember"]</option>
                    @foreach (var sk in Skills) { <option value="@sk">@sk</option> }
                </select>
            </label>
            <label>@L["RepairMaxCycles"]
                <input type="number" min="0" value="@(s.MaxCycles?.ToString() ?? "")"
                       @onchange="e => s.MaxCycles = int.TryParse((string?)e.Value, out var v) ? v : null" />
            </label>
            break;
        case ReviewerRetryBudgetConditionSpec s:
            <label>@L["RepairMode"]
                <select value="@s.Mode" @onchange="e => s.Mode = (string)e.Value!">
                    <option value="withinCap">@L["RepairModeWithinCap"]</option>
                    <option value="exhausted">@L["RepairModeExhausted"]</option>
                </select>
            </label>
            <label>@L["RepairReviewer"]
                <select value="@(s.Agent ?? "")" @onchange="e => s.Agent = string.IsNullOrEmpty((string?)e.Value) ? null : (string)e.Value!">
                    <option value="">@L["AnyMember"]</option>
                    @foreach (var sk in Skills) { <option value="@sk">@sk</option> }
                </select>
            </label>
            <label>@L["ReviewerMaxRetries"]
                <input type="number" min="0" @bind="s.MaxRetries" />
            </label>
            break;
        case DependenciesResolvedConditionSpec s:
            <div class="column-picker">
                <div class="column-picker-label">@L["DependencyResolvedStatuses"]</div>
                @foreach (var c in Columns)
                {
                    var col = c;
                    <label class="column-check"><input type="checkbox" checked="@s.ResolvedStatuses.Contains(col)"
                               @onchange="e => ToggleColumn(s.ResolvedStatuses, col, (bool)e.Value!)" /><span>@col</span></label>
                }
            </div>
            break;
        case TicketAgeConditionSpec s:
            <label>@L["Field"]
                <select value="@s.Field" @onchange="e => s.Field = (string)e.Value!">
                    <option value="createdAt">@L["FieldCreatedAt"]</option>
                    <option value="updatedAt">@L["FieldUpdatedAt"]</option>
                </select>
            </label>
            <label>@L["Mode"]
                <select value="@s.Mode" @onchange="e => s.Mode = (string)e.Value!">
                    <option value="olderThan">@L["ModeOlderThan"]</option>
                    <option value="newerThan">@L["ModeNewerThan"]</option>
                </select>
            </label>
            <label>@L["Hours"]
                <input type="number" @bind="s.Hours" min="1" />
            </label>
            break;
    }

    <div class="node-editor-actions">
        <button class="delete-btn" @onclick="OnDelete">@L["DeleteCondition"]</button>
    </div>
</div>

@code {
    [Parameter] public ConditionSpec Condition { get; set; } = default!;
    [Parameter] public List<string> Skills { get; set; } = new();
    [Parameter] public List<string> Columns { get; set; } = new();
    [Parameter] public EventCallback<ConditionSpec> OnReplace { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    // Verdict outcomes an automation can route on, in the order a reviewer pipeline reads them:
    // the three decisions first, then the three failure modes that must never look like "not reviewed yet".
    private static readonly (string Key, string Label)[] VerdictOutcomeKeys =
    [
        ("SHIP", "VerdictShip"),
        ("FIX", "VerdictFix"),
        ("BLOCK", "VerdictBlock"),
        ("MISSING", "VerdictMissing"),
        ("INVALID", "VerdictInvalid"),
        ("STALE", "VerdictStale"),
    ];

    private string CurrentType => Condition switch
    {
        TicketInColumnConditionSpec => "ticketInColumn",
        MinDescriptionLengthConditionSpec => "fieldLength",
        FieldLengthConditionSpec => "fieldLength",
        PriorityConditionSpec => "priority",
        LabelsConditionSpec => "labels",
        AssignedToConditionSpec => "assignedTo",
        TicketAgeConditionSpec => "ticketAge",
        HasParentConditionSpec => "hasParent",
        AllSubTicketsInStatusConditionSpec => "allSubTicketsInStatus",
        TicketCountInColumnConditionSpec => "ticketCountInColumn",
        VerdictIsConditionSpec => "verdictIs",
        RepairBudgetConditionSpec => "repairBudget",
        ReviewerRetryBudgetConditionSpec => "reviewerRetryBudget",
        DependenciesResolvedConditionSpec => "dependenciesResolved",
        _ => throw new NotSupportedException($"No UI mapping for condition type {Condition.GetType().Name}. Register it in ConditionEditor.razor."),
    };

    private async Task OnTypeChanged(ChangeEventArgs e)
    {
        ConditionSpec spec = (string?)e.Value switch
        {
            "ticketInColumn" => new TicketInColumnConditionSpec { Columns = new List<string> { Columns.FirstOrDefault() ?? "Todo" } },
            "fieldLength" => new FieldLengthConditionSpec(),
            "priority" => new PriorityConditionSpec(),
            "labels" => new LabelsConditionSpec(),
            "assignedTo" => new AssignedToConditionSpec(),
            "ticketAge" => new TicketAgeConditionSpec(),
            "hasParent" => new HasParentConditionSpec(),
            "allSubTicketsInStatus" => new AllSubTicketsInStatusConditionSpec { Statuses = new List<string> { "Done" } },
            "ticketCountInColumn" => new TicketCountInColumnConditionSpec { Columns = new List<string> { "InProgress" }, SameAssignee = true, Operator = "==", Value = 0 },
            "verdictIs" => new VerdictIsConditionSpec { Verdicts = new List<string> { "SHIP" } },
            "repairBudget" => new RepairBudgetConditionSpec(),
            "reviewerRetryBudget" => new ReviewerRetryBudgetConditionSpec(),
            "dependenciesResolved" => new DependenciesResolvedConditionSpec { ResolvedStatuses = new List<string> { "Done" } },
            _ => throw new NotSupportedException($"Unknown condition type key '{e.Value}'. Register it in ConditionEditor.razor."),
        };
        await OnReplace.InvokeAsync(spec);
    }

    private void ToggleColumn(List<string> list, string col, bool on)
    {
        if (on) { if (!list.Contains(col)) list.Add(col); }
        else { list.Remove(col); }
    }
}

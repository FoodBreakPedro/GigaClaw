@using System.Net.Http.Json
@using GigaClaw.Core.Automation
@inject LocalizationService L
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav

<div class="node-editor">
    <label>@L["ActionType"]
        <select value="@CurrentType" @onchange="OnTypeChanged">
            <option value="runAgent">@L["ActionRunAgent"]</option>
            <option value="moveTicketStatus">@L["ActionMoveTicket"]</option>
            <option value="setLabels">@L["ActionSetLabels"]</option>
            <option value="assignTicket">@L["ActionAssignTicket"]</option>
            <option value="addComment">@L["ActionAddComment"]</option>
            <option value="commitAgentMemory">@L["ActionCommitAgentMemory"]</option>
            <option value="consolidateAgentMemory">@L["ActionConsolidateAgentMemory"]</option>
            <option value="executePowerShell">@L["ActionExecutePowerShell"]</option>
            <option value="createTicket">@L["ActionCreateTicket"]</option>
            <option value="httpRequest">@L["ActionHttpRequest"]</option>
            <option value="startTeamRun">@L["ActionStartTeamRun"]</option>
            <option value="parallelRunAgents">@L["ActionParallelRunAgents"]</option>
            <option value="enqueueMerge">@L["ActionEnqueueMerge"]</option>
        </select>
    </label>

    @switch (Action)
    {
        case RunAgentActionSpec s:
            <label>@L["Agent"]
                <select value="@s.Agent" @onchange="e => s.Agent = (string)e.Value!">
                    @foreach (var m in Members) { <option value="@m">@m</option> }
                    @if (!Members.Contains(s.Agent) && !string.IsNullOrEmpty(s.Agent))
                    {
                        <option value="@s.Agent">@s.Agent @L["ModelCustom"]</option>
                    }
                </select>
            </label>
            <label>@L["MaxTurns"]
                <input type="number" @bind="s.MaxTurns" />
            </label>
            <label>@L["ConcurrencyGroup"]
                <input placeholder="@L["ConcurrencyPlaceholder"]" value="@(s.ConcurrencyGroup ?? "")"
                       @onchange="e => s.ConcurrencyGroup = string.IsNullOrEmpty((string?)e.Value) ? null : (string)e.Value!" />
            </label>
            <label>@L["MutuallyExclusive"]
                <input value="@JoinGroups(s.MutuallyExclusiveWith)"
                       @onchange="e => s.MutuallyExclusiveWith = SplitGroups((string?)e.Value)" />
            </label>
            <label>@L["Model"]
                <select @key="@($"{s.Model}#{AllModels.Count}")" value="@(s.Model ?? "")" @onchange="e => s.Model = string.IsNullOrEmpty((string?)e.Value) ? null : (string)e.Value!">
                    <option value="">@L["ModelDefault"]</option>
                    <optgroup label="Claude">
                        @foreach (var m in ClaudeModels)
                        {
                            <option value="@m">@m</option>
                        }
                    </optgroup>
                    @if (_ollamaModels.Count > 0)
                    {
                        <optgroup label="Local (Ollama)">
                            @foreach (var m in _ollamaModels)
                            {
                                <option value="@m">@m</option>
                            }
                        </optgroup>
                    }
                    @if (!string.IsNullOrEmpty(s.Model) && !AllModels.Contains(s.Model))
                    {
                        <option value="@s.Model">@s.Model @L["ModelCustom"]</option>
                    }
                </select>
            </label>
            break;
        case MoveTicketStatusActionSpec s:
            <label>@L["NewColumn"]
                <select @bind="s.To">
                    @foreach (var c in Columns) { <option value="@c">@c</option> }
                </select>
            </label>
            break;
        case SetLabelsActionSpec s:
            <label>@L["LabelsToAdd"]
                <input placeholder="@L["LabelsCsvPlaceholder"]" value="@JoinGroups(s.Add)"
                       @onchange="e => s.Add = SplitGroups((string?)e.Value)" />
            </label>
            <label>@L["LabelsToRemove"]
                <input placeholder="@L["LabelsCsvPlaceholder"]" value="@JoinGroups(s.Remove)"
                       @onchange="e => s.Remove = SplitGroups((string?)e.Value)" />
            </label>
            break;
        case AssignTicketActionSpec s:
            <label>@L["AssignTo"]
                <select value="@(s.Slug ?? "")" @onchange="e => s.Slug = string.IsNullOrEmpty((string?)e.Value) ? null : (string)e.Value!">
                    <option value="">— @L["Nobody"] —</option>
                    @foreach (var m in Members) { <option value="@m">@m</option> }
                    <option value="{previousAssignee}">{previousAssignee}</option>
                </select>
            </label>
            break;
        case AddCommentActionSpec s:
            <label>@L["CommentContent"]
                <textarea @bind="s.Content" placeholder="@L["CommentContentPlaceholder"]"></textarea>
            </label>
            <label>@L["CommentAuthor"]
                <select @bind="s.Author">
                    @foreach (var m in Members) { <option value="@m">@m</option> }
                </select>
            </label>
            break;
        case CommitAgentMemoryActionSpec s:
            <label>@L["Agent"]
                <select value="@s.Agent" @onchange="e => s.Agent = (string)e.Value!">
                    @foreach (var m in Members) { <option value="@m">@m</option> }
                    @if (!Members.Contains(s.Agent) && !string.IsNullOrEmpty(s.Agent))
                    {
                        <option value="@s.Agent">@s.Agent @L["ModelCustom"]</option>
                    }
                </select>
            </label>
            break;
        case ConsolidateAgentMemoryActionSpec s:
            <label>@L["Agent"]
                <select value="@s.Agent" @onchange="e => s.Agent = (string)e.Value!">
                    @foreach (var m in Members) { <option value="@m">@m</option> }
                    @if (!Members.Contains(s.Agent) && !string.IsNullOrEmpty(s.Agent))
                    {
                        <option value="@s.Agent">@s.Agent @L["ModelCustom"]</option>
                    }
                </select>
            </label>
            <label>@L["MaxTurns"]
                <input type="number" @bind="s.MaxTurns" />
            </label>
            <label>@L["CsmInstructionFile"]
                <input placeholder=".agents/memory-consolidation.md" @bind="s.InstructionFile" />
            </label>
            break;
        case CreateTicketActionSpec s:
            <label>@L["CtTitle"]
                <input placeholder="@L["CtTitlePlaceholder"]" @bind="s.Title" />
            </label>
            <label>@L["CtDescription"]
                <textarea placeholder="@L["CtDescriptionPlaceholder"]" @bind="s.Description" rows="3"></textarea>
            </label>
            <label>@L["CtStatus"]
                <select @bind="s.Status">
                    @foreach (var c in Columns) { <option value="@c">@c</option> }
                </select>
            </label>
            <label>@L["AssignTo"]
                <select value="@(s.AssignedTo ?? "")" @onchange="e => s.AssignedTo = string.IsNullOrEmpty((string?)e.Value) ? null : (string)e.Value!">
                    <option value="">— @L["Nobody"] —</option>
                    @foreach (var m in Members) { <option value="@m">@m</option> }
                </select>
            </label>
            <label>@L["CtPriority"]
                <select @bind="s.Priority">
                    <option value="Idea">Idea</option>
                    <option value="NiceToHave">NiceToHave</option>
                    <option value="Required">Required</option>
                    <option value="Critical">Critical</option>
                </select>
            </label>
            <label>@L["CtLabels"]
                <input placeholder="@L["LabelsCsvPlaceholder"]" value="@JoinGroups(s.Labels)"
                       @onchange="e => s.Labels = SplitGroups((string?)e.Value)" />
            </label>
            <label>@L["CtCreatedBy"]
                <input placeholder="automation" @bind="s.CreatedBy" />
            </label>
            <label class="checkbox-label">
                <input type="checkbox" @bind="s.SkipIfExists" />
                @L["CtSkipIfExists"]
            </label>
            break;
        case ExecutePowerShellActionSpec s:
            <label>@L["PsScript"]
                <textarea @bind="s.Script" placeholder="@L["PsScriptPlaceholder"]" rows="5"></textarea>
            </label>
            <label>@L["PsScriptFile"]
                <input placeholder="@L["PsScriptFilePlaceholder"]" value="@(s.ScriptFile ?? "")"
                       @onchange="e => s.ScriptFile = string.IsNullOrEmpty((string?)e.Value) ? null : (string)e.Value!" />
            </label>
            <label>@L["PsArguments"]
                <input placeholder="@L["PsArgumentsPlaceholder"]" value="@JoinGroups(s.Arguments)"
                       @onchange="e => s.Arguments = SplitGroups((string?)e.Value)" />
            </label>
            <label>@L["PsTimeout"]
                <input type="number" @bind="s.TimeoutSeconds" />
            </label>
            <label class="checkbox-label">
                <input type="checkbox" @bind="s.AbortOnFailure" />
                @L["PsAbortOnFailure"]
            </label>
            break;
        case HttpRequestActionSpec s:
            <label>@L["HrUrl"]
                <input placeholder="@L["HrUrlPlaceholder"]" @bind="s.Url" />
            </label>
            <label>@L["HrMethod"]
                <select @bind="s.Method">
                    <option value="POST">POST</option>
                    <option value="GET">GET</option>
                    <option value="PUT">PUT</option>
                    <option value="PATCH">PATCH</option>
                    <option value="DELETE">DELETE</option>
                </select>
            </label>
            <label>@L["HrHeaders"]
                <textarea placeholder="@L["HrHeadersPlaceholder"]" rows="3"
                          value="@JoinHeaders(s.Headers)"
                          @onchange="e => s.Headers = SplitHeaders((string?)e.Value)"></textarea>
            </label>
            <label>@L["HrBody"]
                <textarea placeholder="@L["HrBodyPlaceholder"]" rows="5" @bind="s.BodyTemplate"></textarea>
            </label>
            <label>@L["HrSecretRef"]
                <input placeholder="@L["HrSecretRefPlaceholder"]" value="@(s.SecretRef ?? "")"
                       @onchange="e => s.SecretRef = string.IsNullOrWhiteSpace((string?)e.Value) ? null : ((string)e.Value!).Trim()" />
            </label>
            <p class="field-hint">@L["HrCaptureHint"]</p>
            <label>@L["HrTimeout"]
                <input type="number" @bind="s.TimeoutSeconds" />
            </label>
            <label class="checkbox-label">
                <input type="checkbox" @bind="s.AbortOnFailure" />
                @L["HrAbortOnFailure"]
            </label>
            break;
        case StartTeamRunActionSpec s:
            <label>@L["StrTeam"]
                <input placeholder="@L["StrTeamPlaceholder"]" @bind="s.Team" />
            </label>
            <p class="field-hint">@L["StrHint"]</p>
            break;
        case ParallelRunAgentsActionSpec s:
            @foreach (var branch in s.Branches)
            {
                <div class="node-editor-row" @key="branch">
                    <label>@L["PraBranchAgent"]
                        <select value="@branch.Agent" @onchange="e => branch.Agent = (string)e.Value!">
                            @foreach (var m in Members) { <option value="@m">@m</option> }
                            @if (!Members.Contains(branch.Agent) && !string.IsNullOrEmpty(branch.Agent))
                            {
                                <option value="@branch.Agent">@branch.Agent @L["ModelCustom"]</option>
                            }
                        </select>
                    </label>
                    <label>@L["PraBranchKey"]
                        <input placeholder="@L["PraBranchKeyPlaceholder"]" value="@(branch.Key ?? "")"
                               @onchange="e => branch.Key = string.IsNullOrWhiteSpace((string?)e.Value) ? null : (string)e.Value!" />
                    </label>
                    <label>@L["PraBranchTitle"]
                        <input value="@(branch.Title ?? "")"
                               @onchange="e => branch.Title = string.IsNullOrWhiteSpace((string?)e.Value) ? null : (string)e.Value!" />
                    </label>
                    <label>@L["PraBranchPrompt"]
                        <textarea rows="2" value="@(branch.Prompt ?? "")"
                                  @onchange="e => branch.Prompt = string.IsNullOrWhiteSpace((string?)e.Value) ? null : (string)e.Value!"></textarea>
                    </label>
                    <button class="delete-btn" @onclick="() => s.Branches.Remove(branch)">@L["PraRemoveBranch"]</button>
                </div>
            }
            <button @onclick="() => s.Branches.Add(NewBranch())">@L["PraAddBranch"]</button>
            <label>@L["PraMaxConcurrency"]
                <input type="number" min="0" @bind="s.MaxConcurrency" />
            </label>
            <label>@L["PraJoin"]
                <select value="@s.Join" @onchange="e => s.Join = (string)e.Value!">
                    <option value="allDone">@L["PraJoinAllDone"]</option>
                    <option value="quorum">@L["PraJoinQuorum"]</option>
                    <option value="firstFailure">@L["PraJoinFirstFailure"]</option>
                </select>
            </label>
            @if (string.Equals(s.Join, "quorum", StringComparison.OrdinalIgnoreCase))
            {
                <label>@L["PraQuorum"]
                    <input type="number" min="1" @bind="s.Quorum" />
                </label>
            }
            <label>@L["PraSynthesizer"]
                <select value="@(s.Synthesizer ?? "")" @onchange="e => s.Synthesizer = string.IsNullOrEmpty((string?)e.Value) ? null : (string)e.Value!">
                    <option value="">@L["PraSynthesizerNone"]</option>
                    @foreach (var m in Members) { <option value="@m">@m</option> }
                </select>
            </label>
            <label>@L["PraOnPartialFailure"]
                <select value="@s.OnPartialFailure" @onchange="e => s.OnPartialFailure = (string)e.Value!">
                    <option value="synthesize">@L["PraPartialSynthesize"]</option>
                    <option value="failFast">@L["PraPartialFailFast"]</option>
                </select>
            </label>
            <label>@L["PraRunSlug"]
                <input placeholder="parallel-run" @bind="s.RunSlug" />
            </label>
            <p class="field-hint">@L["PraHint"]</p>
            break;
        case EnqueueMergeActionSpec s:
            <label>@L["EmIntegrationCommand"]
                <input placeholder="@L["EmIntegrationCommandPlaceholder"]" value="@(s.IntegrationCommand ?? "")"
                       @onchange="e => s.IntegrationCommand = string.IsNullOrWhiteSpace((string?)e.Value) ? null : (string)e.Value!" />
            </label>
            <p class="field-hint">@L["EmHint"]</p>
            break;
    }

    <div class="node-editor-actions">
        <button class="delete-btn" @onclick="OnDelete">@L["DeleteAction"]</button>
    </div>
</div>

@code {
    [Parameter] public ActionSpec Action { get; set; } = default!;
    [Parameter] public List<string> Skills { get; set; } = new();
    [Parameter] public List<string> Columns { get; set; } = new();
    [Parameter] public List<string> Members { get; set; } = new();
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public EventCallback<ActionSpec> OnReplace { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    private static readonly IReadOnlyList<string> ClaudeModels = ClaudeModelCatalog.Models;

    private List<string> _ollamaModels = new();
    private List<string> AllModels => ClaudeModels.Concat(_ollamaModels).ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Slug))
        {
            try
            {
                var http = HttpFactory.CreateClient();
                http.BaseAddress = new Uri(Nav.BaseUri);
                _ollamaModels = await http.GetFromJsonAsync<List<string>>($"/api/projects/{Slug}/ollama-models") ?? new();
            }
            catch { /* non-blocking */ }
        }
    }

    private string CurrentType => Action switch
    {
        RunAgentActionSpec => "runAgent",
        MoveTicketStatusActionSpec => "moveTicketStatus",
        SetLabelsActionSpec => "setLabels",
        AssignTicketActionSpec => "assignTicket",
        AddCommentActionSpec => "addComment",
        CommitAgentMemoryActionSpec => "commitAgentMemory",
        ConsolidateAgentMemoryActionSpec => "consolidateAgentMemory",
        ExecutePowerShellActionSpec => "executePowerShell",
        CreateTicketActionSpec => "createTicket",
        HttpRequestActionSpec => "httpRequest",
        StartTeamRunActionSpec => "startTeamRun",
        ParallelRunAgentsActionSpec => "parallelRunAgents",
        EnqueueMergeActionSpec => "enqueueMerge",
        _ => throw new NotSupportedException($"No UI mapping for action type {Action.GetType().Name}. Register it in ActionEditor.razor."),
    };

    // A branch always starts on a real member: an empty agent is refused when the action runs, and
    // the editor should not be the place that produces one.
    private ParallelBranchSpec NewBranch() =>
        new() { Agent = Members.FirstOrDefault() ?? "programmer" };

    private static string JoinGroups(List<string> items) => string.Join(", ", items);
    private static List<string> SplitGroups(string? value) =>
        (value ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

    // Headers are edited as one "Name: value" per line.
    private static string JoinHeaders(Dictionary<string, string> headers) =>
        string.Join("\n", headers.Select(h => $"{h.Key}: {h.Value}"));

    private static Dictionary<string, string> SplitHeaders(string? value)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var line in (value ?? string.Empty).Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var idx = line.IndexOf(':');
            if (idx <= 0) continue;
            result[line[..idx].Trim()] = line[(idx + 1)..].Trim();
        }
        return result;
    }

    private async Task OnTypeChanged(ChangeEventArgs e)
    {
        ActionSpec spec = (string?)e.Value switch
        {
            "runAgent" => new RunAgentActionSpec { Agent = Members.FirstOrDefault() ?? "producer" },
            "moveTicketStatus" => new MoveTicketStatusActionSpec { To = Columns.FirstOrDefault() ?? "Todo" },
            "setLabels" => new SetLabelsActionSpec(),
            "assignTicket" => new AssignTicketActionSpec(),
            "addComment" => new AddCommentActionSpec(),
            "commitAgentMemory" => new CommitAgentMemoryActionSpec { Agent = Members.FirstOrDefault() ?? "programmer" },
            "consolidateAgentMemory" => new ConsolidateAgentMemoryActionSpec { Agent = Members.FirstOrDefault() ?? "programmer" },
            "executePowerShell" => new ExecutePowerShellActionSpec(),
            "createTicket" => new CreateTicketActionSpec(),
            "httpRequest" => new HttpRequestActionSpec(),
            "startTeamRun" => new StartTeamRunActionSpec { Team = "" },
            "parallelRunAgents" => new ParallelRunAgentsActionSpec { Branches = { NewBranch() } },
            "enqueueMerge" => new EnqueueMergeActionSpec(),
            _ => throw new NotSupportedException($"Unknown action type key '{e.Value}'. Register it in ActionEditor.razor."),
        };
        await OnReplace.InvokeAsync(spec);
    }
}
